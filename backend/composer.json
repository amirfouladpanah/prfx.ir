{
  "name": "prfx/laravel-shop-api",
  "type": "project",
  "description": "Laravel API backend for the PRFX Persian perfume storefront",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": { "App\\": "app/" },
    "files": ["app/Support/helpers.php"]
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
